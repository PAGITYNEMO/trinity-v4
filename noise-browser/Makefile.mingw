# NoiseBrowser — TRINITY 四极浏览器（MinGW 构建）
# 用法：mingw32-make -f Makefile.mingw
# 产物：noise-browser.exe + 需 WebView2Loader.dll（bin/ 内已备，自动复制）

CXX     := g++
CXXFLAGS:= -O2 -Wall -Wno-unused-parameter -fms-extensions -std=c++17 -D_CRT_SECURE_NO_WARNINGS
INC     := -Isrc -Iinclude
LIBS    := -luser32 -lgdi32 -lcomctl32 -lole32 -ladvapi32
TARGET  := noise-browser.exe

SRCS := src/main.cpp
OBJS := $(SRCS:.cpp=.o)

all: bin/WebView2Loader.dll $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) -o $@ $(OBJS) $(LIBS)
	-cp -f bin/WebView2Loader.dll . 2>/dev/null || copy /y bin\WebView2Loader.dll . >nul 2>&1 || true

%.o: %.cpp src/field.h include/WebView2.h
	$(CXX) $(CXXFLAGS) $(INC) -c $< -o $@

clean:
	-del /q $(OBJS) $(TARGET) 2>nul || rm -f $(OBJS) $(TARGET)
